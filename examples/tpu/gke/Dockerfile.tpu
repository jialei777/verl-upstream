# Use Ray 2.56.0 Python 3.12 as base.
FROM rayproject/ray:2.56.0-py312

USER root
WORKDIR /

# --- Install system build & runtime dependencies ---
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && apt-get install -y \
    gcc-12 \
    g++-12 \
    build-essential \
    cmake \
    ninja-build \
    libgoogle-perftools4 \
    libopenblas-base \
    libopenmpi-dev \
    libomp-dev \
    && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-12 100 --slave /usr/bin/g++ g++ /usr/bin/g++-12 \
    && rm -rf /var/lib/apt/lists/*

# --- Add torchtitan & torch_tpu base dependencies ---
RUN --mount=type=cache,target=/root/.cache/pip \
    export PIP_CACHE_DIR=/root/.cache/pip && \
    (pip uninstall -y torch torchvision || true) && \
    pip install --upgrade pip uv keyrings.google-artifactregistry-auth pandas==2.3.3 && \
    pip install "jax[tpu]==0.10.2" -f https://storage.googleapis.com/jax-releases/libtpu_releases.html && \
    pip install "tokamax==0.0.14" && \
    pip install torch==2.13.0 torchvision==0.28.0 --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-deps "jax==0.10.2" "jaxlib==0.10.2" "libtpu==0.0.47" -f https://storage.googleapis.com/jax-releases/libtpu_releases.html && \
    pip install 'typeguard==2.13.3' && \
    pip install portpicker absl-py numpy gcsfs frozendict triton fairscale tamm "spmd_types==0.2.1" "tyro>=1.0.5"

# --- Install torchtitan (latest main @ f880cc73725de77d892ecab888244e7718e5ad65) ---
ARG GITHUB_USER
ARG GITHUB_TOKEN
RUN --mount=type=cache,target=/root/.cache/pip \
    export PIP_CACHE_DIR=/root/.cache/pip && \
    git clone https://${GITHUB_USER}:${GITHUB_TOKEN}@github.com/google-pytorch/torchtitan.git /torchtitan && \
    git -C /torchtitan checkout f880cc73725de77d892ecab888244e7718e5ad65 && \
    pip install -r /torchtitan/requirements.txt

# --- Install vLLM v0.29.0 ---
# Patch vLLM's TPU requirements to avoid pulling upstream tpu-inference (JAX/torchax) over vllm-torchtpu
RUN --mount=type=cache,target=/root/.cache/pip \
    export PIP_CACHE_DIR=/root/.cache/pip && \
    git clone --depth 1 --branch v0.29.0 https://github.com/vllm-project/vllm.git /vllm && \
    sed -i '/tpu-inference/d' /vllm/requirements/tpu.txt && \
    pip install --upgrade pip setuptools && \
    pip install cmake ninja setuptools-scm setuptools-rust "pyzmq>=27" && \
    TORCH_DEVICE_BACKEND_AUTOLOAD=0 SETUPTOOLS_SCM_PRETEND_VERSION=0.29.0 VLLM_TARGET_DEVICE="empty" \
        pip install --no-build-isolation -e /vllm && \
    pip install tpu-info pathwaysutils "numba==0.65.0" "transformers>=5.10.4,<5.11" "fastapi<0.137"

# --- Install verl Dependencies & lock PyTorch / JAX / libtpu / Transformers versions ---
RUN --mount=type=cache,target=/root/.cache/pip \
    export PIP_CACHE_DIR=/root/.cache/pip && \
    pip install \
        accelerate \
        codetiming \
        datasets \
        dill \
        hydra-core \
        peft \
        "pyarrow>=19.0.0" \
        pybind11 \
        pylatexenc \
        "tensordict>=0.10.0" \
        torchdata \
        "transformers>=5.10.4,<5.11" \
        wandb \
        "packaging>=20.0" \
        uvicorn \
        "fastapi<0.137" \
        latex2sympy2_extended \
        math_verify \
        tensorboard \
        TransferQueue==0.1.8 && \
    pip install --no-deps torch==2.13.0 torchvision==0.28.0 --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-deps \
        "jax==0.10.2" \
        "jaxlib==0.10.2" \
        "libtpu==0.0.47" \
        "numba==0.65.0" \
        "transformers>=5.10.4,<5.11" \
        "fastapi<0.137" \
        -f https://storage.googleapis.com/jax-releases/libtpu_releases.html

# --- Install vllm-project/vllm-torchtpu (@ 9faafb177ca1f1fca39d404caa5a7fadbfdb9a06, includes #1160 same-step prefix-hit fix) ---
RUN --mount=type=cache,target=/root/.cache/pip \
    export PIP_CACHE_DIR=/root/.cache/pip && \
    git clone https://${GITHUB_USER}:${GITHUB_TOKEN}@github.com/vllm-project/vllm-torchtpu.git /vllm-torchtpu && \
    git -C /vllm-torchtpu checkout 9faafb177ca1f1fca39d404caa5a7fadbfdb9a06 && \
    ln -sfnT /vllm-torchtpu /torchtpu-vllm && \
    TORCH_DEVICE_BACKEND_AUTOLOAD=0 SETUPTOOLS_SCM_PRETEND_VERSION_FOR_VLLM_TORCHTPU=0.0.0 \
        pip install --no-build-isolation --pre --no-deps -e /vllm-torchtpu

# --- Install and verify pinned torch-tpu & tpu-sync-torch versions ---
# Placed last so refreshing AUTH_TOKEN or bumping TORCH_TPU_VERSION / TPU_SYNC_VERSION does not invalidate earlier layers.
ARG AUTH_TOKEN
ARG TORCH_TPU_VERSION=0.1.1+release.2026.9.22.20260927223741
ARG TPU_SYNC_VERSION=0.0.1.dev20261001132139

RUN --mount=type=cache,target=/root/.cache/pip \
    export PIP_CACHE_DIR=/root/.cache/pip && \
    pip install --pre --no-deps \
        "torch-tpu==${TORCH_TPU_VERSION}" \
        "tpu-sync-torch==${TPU_SYNC_VERSION}" \
        --index-url "https://oauth2accesstoken:${AUTH_TOKEN}@us-python.pkg.dev/ml-oss-artifacts-transient/torch-tpu-virtual-registry/simple/" && \
    python -c "import importlib.metadata as m, sys; \
want = {'torch': '2.13.0+cpu', 'torch-tpu': '${TORCH_TPU_VERSION}', 'tpu-sync-torch': '${TPU_SYNC_VERSION}'}; \
got = {k: m.version(k) for k in want}; \
print('Pinned torch / torch_tpu / tpu-sync:', got); \
sys.exit(0 if got == want else f'Version drift: want {want}, got {got}')"

WORKDIR /app

# Add /app, /vllm-torchtpu, and /torchtitan to PYTHONPATH.
ENV VLLM_TARGET_DEVICE="tpu" \
    PIP_EXTRA_INDEX_URL="" \
    PIP_INDEX_URL="" \
    PYTHONPATH="/vllm-torchtpu/src:/vllm-torchtpu:/torchtpu-vllm/src:/torchtpu-vllm:/app:/torchtitan:/torchtitan/torchtitan${PYTHONPATH:+:$PYTHONPATH}"
