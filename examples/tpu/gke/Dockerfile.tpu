# syntax=docker/dockerfile:1.7
#
# TPU image for verl on the vLLM 0.29 / torch 2.13 / torch_tpu / tpu-sync stack.
#
# We start FROM upstream vllm-torchtpu's production image rather than rebuilding
# that stack from source, because the tpu-sync-torch wheel their pyproject pins
# (0.0.1.dev20260917080754) is not published to the public raiden registry;
# their prebuilt image ships the exact matched set:
#
#     torch 2.13.0+cpu · torch_tpu 0.1.1.dev20260912075415
#     tpu_sync_torch 0.0.1.dev20260917080754 · vLLM 0.29.0
#     ray 2.58.0 · transformers 5.10.4 · libtpu 0.0.47
#
# The GitHub PAT for cloning google-pytorch/torchtitan is passed via BuildKit
# `--secret id=ghtoken` so it is never persisted in image layer history.
FROM us-central1-docker.pkg.dev/cloud-ullm-inference-ci-cd/vllm-torchtpu/torchtpu-vllm-prod:latest

# Record the pins we must not disturb, so the assertion at the bottom can prove
# that nothing installed below silently re-resolved them.
RUN python -c "\
import importlib.metadata as md, json;\
print(json.dumps({p: md.version(p) for p in\
 ['torch','torch_tpu','tpu_sync_torch','vllm','ray','transformers','libtpu']}))" \
    > /baseline_pins.json && cat /baseline_pins.json

# KubeRay's default readiness/liveness probes execute `wget`, which the slim
# upstream base image omits; without it pods stay 1/2 Ready and get killed by
# kubelet after the liveness timeout.
RUN apt-get update && apt-get install -y --no-install-recommends wget \
 && rm -rf /var/lib/apt/lists/*

# --- torchtitan: the TPU training engine verl's actor runs on ---
# verl selects it via model_engine=torchtitan / actor.strategy=torchtitan, and
# it must be the google-pytorch fork, which is the one carrying TPU support.
# 971dd82c matches verl's TorchTitanEngine config imports (ActivationCheckpointConfig,
# etc.) and is verified compatible with torch 2.13.
ARG GITHUB_USER
ARG TORCHTITAN_REF=971dd82ceb3dd191088a2a74cdec594682c95ef1
RUN --mount=type=secret,id=ghtoken \
    git clone "https://${GITHUB_USER}:$(cat /run/secrets/ghtoken)@github.com/google-pytorch/torchtitan.git" /torchtitan \
 && cd /torchtitan \
 && git checkout ${TORCHTITAN_REF} \
 && git log -1 --format='torchtitan at %h %ad %s' --date=short

# Install torchtitan's dependencies and register /torchtitan via a .pth file
# in site-packages so it stays importable even when Ray's runtime_env replaces
# PYTHONPATH.
RUN pip install --no-cache-dir -r /torchtitan/requirements.txt \
 && printf '/torchtitan\n/torchtitan/torchtitan\n' > /usr/local/lib/python3.12/site-packages/torchtitan.pth

# --- verl runtime dependencies ---
# Pre-installed so Ray job submission does not download them per-run.
# transformers is intentionally NOT pinned to 4.57.6 here - the upstream stack
# ships 5.10.4 and vLLM 0.29.0 expects it.
RUN pip install --no-cache-dir \
    accelerate \
    codetiming \
    datasets \
    dill \
    hydra-core \
    peft \
    "pyarrow>=19.0.0" \
    pybind11 \
    pylatexenc \
    "tensordict>=0.8.0,<=0.10.0,!=0.9.0" \
    torchdata \
    wandb \
    "packaging>=20.0" \
    uvicorn \
    fastapi \
    latex2sympy2_extended \
    math_verify \
    tensorboard \
    TransferQueue==0.1.8

# Fail the build if anything above moved a load-bearing pin, rather than
# shipping an image that silently is not the stack we set out to run.
RUN python - <<'PY'
import importlib.metadata as md, json, sys
base = json.load(open('/baseline_pins.json'))
bad = []
for pkg, want in base.items():
    got = md.version(pkg)
    print(f"  {pkg:16s} {want:28s} -> {got}")
    if got != want:
        bad.append(f"{pkg}: {want} -> {got}")
if bad:
    sys.exit("PIN DRIFT, image is not the intended stack:\n  " + "\n  ".join(bad))
print("all load-bearing pins intact")
PY

WORKDIR /app

# torchtpu-vllm lives at /workspace/vllm-torchtpu in the upstream image (not
# /torchtpu-vllm as in the 0.22.1 image), and is src-layout.
ENV PYTHONPATH="/workspace/vllm-torchtpu/src:/workspace/vllm-torchtpu:/app:/torchtitan:/torchtitan/torchtitan"
