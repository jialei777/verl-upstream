# Use Ray 2.56.0 Python 3.12 as base.
FROM rayproject/ray:2.56.0-py312

RUN sudo apt-get update && sudo apt-get install -y \
    gcc-12 \
    g++-12 \
    build-essential \
    cmake \
    ninja-build \
    libgoogle-perftools4 \
    libopenblas-base \
    libopenmpi-dev \
    libomp-dev \
    && sudo update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-12 100 --slave /usr/bin/g++ g++ /usr/bin/g++-12 \
    && sudo rm -rf /var/lib/apt/lists/*

RUN pip uninstall -y torch torchvision || true
RUN pip install --upgrade pip uv keyrings.google-artifactregistry-auth pandas==2.3.3

ARG AUTH_TOKEN
# Use PIP_EXTRA_INDEX_URL so PyPI remains the primary index for standard packages like JAX
ENV PIP_EXTRA_INDEX_URL="https://oauth2accesstoken:${AUTH_TOKEN}@us-python.pkg.dev/ml-oss-artifacts-transient/torch-tpu-virtual-registry/simple/"

# --- Add torchtitan & torch_tpu setup ---
USER root
WORKDIR /

RUN pip install "jax[tpu]==0.10.2" -f https://storage.googleapis.com/jax-releases/libtpu_releases.html
RUN pip install "tokamax==0.0.14"
RUN pip install torch==2.13.0 --index-url https://download.pytorch.org/whl/cpu
RUN pip install torchvision==0.28.0 --index-url https://download.pytorch.org/whl/cpu
RUN pip install libtpu==0.0.47 -f https://storage.googleapis.com/jax-releases/libtpu_releases.html

RUN pip install --pre --no-deps \
    "torch-tpu==0.1.1.dev20260912075415" \
    "tpu-sync-torch==0.0.1.dev20260927082445" \
    --index-url "https://oauth2accesstoken:${AUTH_TOKEN}@us-python.pkg.dev/ml-oss-artifacts-transient/torch-tpu-virtual-registry/simple/"

RUN pip install 'typeguard==2.13.3'
RUN pip install portpicker absl-py numpy gcsfs frozendict triton fairscale tamm "spmd_types==0.2.1" "tyro>=1.0.5"

# --- Install torchtitan (latest main @ f880cc73725de77d892ecab888244e7718e5ad65) ---
ARG GITHUB_USER
ARG GITHUB_TOKEN
RUN git clone https://${GITHUB_USER}:${GITHUB_TOKEN}@github.com/google-pytorch/torchtitan.git /torchtitan
WORKDIR /torchtitan
RUN git checkout f880cc73725de77d892ecab888244e7718e5ad65
RUN pip install -r requirements.txt
WORKDIR /

# --- Install vLLM v0.29.0 and vllm-project/vllm-torchtpu (@ 9faafb177ca1f1fca39d404caa5a7fadbfdb9a06, includes #1160 same-step prefix-hit fix) ---
ENV VLLM_TARGET_DEVICE="tpu"
RUN git clone --depth 1 --branch v0.29.0 https://github.com/vllm-project/vllm.git /vllm
RUN git clone https://${GITHUB_USER}:${GITHUB_TOKEN}@github.com/vllm-project/vllm-torchtpu.git /vllm-torchtpu && \
    ln -sfnT /vllm-torchtpu /torchtpu-vllm

WORKDIR /vllm-torchtpu
RUN git checkout 9faafb177ca1f1fca39d404caa5a7fadbfdb9a06
WORKDIR /

# Patch vLLM's TPU requirements to avoid pulling upstream tpu-inference (JAX/torchax) over vllm-torchtpu
RUN sed -i '/tpu-inference/d' /vllm/requirements/tpu.txt

WORKDIR /vllm-torchtpu

RUN pip install --upgrade pip setuptools && \
    pip install cmake ninja setuptools-scm setuptools-rust "pyzmq>=27" && \
    TORCH_DEVICE_BACKEND_AUTOLOAD=0 SETUPTOOLS_SCM_PRETEND_VERSION=0.29.0 VLLM_TARGET_DEVICE="empty" pip install --no-build-isolation -e ../vllm
RUN pip install tpu-info pathwaysutils "numba==0.65.0" "transformers>=5.10.4,<5.11" "fastapi<0.137" && \
    TORCH_DEVICE_BACKEND_AUTOLOAD=0 SETUPTOOLS_SCM_PRETEND_VERSION_FOR_VLLM_TORCHTPU=0.0.0 pip install --no-build-isolation --pre --no-deps -e .

# --- Install verl Dependencies ---
RUN pip install --no-cache-dir \
    accelerate \
    codetiming \
    datasets \
    dill \
    hydra-core \
    peft \
    "pyarrow>=19.0.0" \
    pybind11 \
    pylatexenc \
    "tensordict>=0.10.0" \
    torchdata \
    "transformers>=5.10.4,<5.11" \
    wandb \
    "packaging>=20.0" \
    uvicorn \
    "fastapi<0.137" \
    latex2sympy2_extended \
    math_verify \
    tensorboard \
    TransferQueue==0.1.8

# Re-verify and lock exact PyTorch / TorchTPU / JAX / libtpu / Transformers versions after all dependency resolvers run
RUN pip install --no-deps torch==2.13.0 torchvision==0.28.0 --index-url https://download.pytorch.org/whl/cpu && \
    pip install --pre --no-deps \
    "torch-tpu==0.1.1.dev20260912075415" \
    "tpu-sync-torch==0.0.1.dev20260927082445" \
    --index-url "https://oauth2accesstoken:${AUTH_TOKEN}@us-python.pkg.dev/ml-oss-artifacts-transient/torch-tpu-virtual-registry/simple/" && \
    pip install --no-deps \
    "jax==0.10.2" \
    "jaxlib==0.10.2" \
    "libtpu==0.0.47" \
    "numba==0.65.0" \
    "transformers>=5.10.4,<5.11" \
    "fastapi<0.137" \
    -f https://storage.googleapis.com/jax-releases/libtpu_releases.html

# (a) Why needed: Bake into the container image:
#     1. ray-project/ray#66400 fix in ray/_private/worker.py so multi-host TPU slices
#        with global TPU_VISIBLE_CHIPS (e.g. 12,13,14,15 on 4-host v6e-16) do not raise
#        IndexError in get_assigned_accelerator_ids.
#     2. PyTorch 2.13 FSDP2 finalize_backward fix in _fsdp_param_group.py so TPU stream
#        events wait on self.device_handle.current_stream() instead of torch.accelerator.
#     3. verl.pth and PYTHONPATH entries for /workspace/verl and /data/verl so spawned
#        RayWorkerWrapper processes always resolve verl without runtime site-packages patching.
# (b) Strictly necessary or cluster-configurable? Baking these into Dockerfile.tpu makes
#     the runtime patches in prepare_tpu_env.py / bootstrap.py a no-op on updated images.
# (c) Why smaller models (0.6B, 4B) didn't require it: 0.6B/4B run on 2-host v6e-8 slices
#     where TPU_VISIBLE_CHIPS indices happen to be <8.
RUN python3 - <<'PY'
from pathlib import Path
import ray
import torch

site_packages = Path(ray.__file__).resolve().parent
worker_path = site_packages / "_private" / "worker.py"
old_w = """        if self.original_visible_accelerator_ids.get(resource_name, None) is not None:
            original_ids = self.original_visible_accelerator_ids[resource_name]
            assigned_ids = {str(original_ids[i]) for i in assigned_ids}
        return list(assigned_ids)"""
new_w = """        if self.original_visible_accelerator_ids.get(resource_name, None) is not None:
            original_ids = self.original_visible_accelerator_ids[resource_name]
            if all(i < len(original_ids) for i in assigned_ids):
                assigned_ids = {str(original_ids[i]) for i in assigned_ids}
            else:
                assigned_ids = {str(x) for x in original_ids[: len(assigned_ids)]}
        return list(assigned_ids)"""
w_txt = worker_path.read_text()
if old_w in w_txt:
    worker_path.write_text(w_txt.replace(old_w, new_w, 1))

fsdp_pg_path = (
    Path(torch.__file__).resolve().parent / "distributed" / "fsdp" / "_fully_shard" / "_fsdp_param_group.py"
)
if fsdp_pg_path.is_file():
    pg_txt = fsdp_pg_path.read_text()
    bad_line = "torch.accelerator.current_stream().wait_event(event)"
    good_line = "self.device_handle.current_stream().wait_event(event)"
    if bad_line in pg_txt:
        fsdp_pg_path.write_text(pg_txt.replace(bad_line, good_line))

(site_packages.parent / "verl.pth").write_text("/workspace/verl\n/data/verl\n")
PY

WORKDIR /app

ENV PIP_EXTRA_INDEX_URL=""
ENV PIP_INDEX_URL=""

# Add /app, /workspace/verl, /data/verl, /vllm-torchtpu, and /torchtitan to PYTHONPATH.
ENV PYTHONPATH="/vllm-torchtpu/src:/vllm-torchtpu:/torchtpu-vllm/src:/torchtpu-vllm:/app:/workspace/verl:/data/verl:/torchtitan:/torchtitan/torchtitan${PYTHONPATH:+:$PYTHONPATH}"
