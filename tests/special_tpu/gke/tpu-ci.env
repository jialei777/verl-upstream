# Settings of the TPU CI (tests/special_tpu/run_tpu_e2e_ci.sh). Every value can be overridden by an
# environment variable of the same name.

# Ray pod image. By default CI builds it from examples/tpu/grpo/Dockerfile of the verl under test (below) and pushes it to
# TPU_CI_IMAGE_REPO, tagged df-<first 16 hex digits of the Dockerfile's sha256>; later runs reuse that tag while
# the Dockerfile is unchanged. The build runs as a Kubernetes Job (gke/image-build-job.yaml) with BuildKit
# TPU_CI_BUILDKIT_IMAGE. Set TPU_CI_IMAGE to skip the build and use a prebuilt image.
TPU_CI_IMAGE="${TPU_CI_IMAGE:-}"
TPU_CI_IMAGE_REPO="${TPU_CI_IMAGE_REPO:-us-west2-docker.pkg.dev/tpu-pytorch/raycluster/verl-tpu-ci}"
TPU_CI_BUILDKIT_IMAGE="${TPU_CI_BUILDKIT_IMAGE:-moby/buildkit:v0.34.0}"

# GCS bucket mounted at /data in the Ray pods, and the directory of the bucket that holds the models
# (<dir>/assets/hf/Qwen3-*) and the data (<dir>/data/gsm8k, <dir>/data/gsm8k_sft). It is passed to the
# example scripts as RAY_DATA_HOME.
TPU_CI_BUCKET="${TPU_CI_BUCKET:-torchprime}"
TPU_CI_DATA_HOME="${TPU_CI_DATA_HOME:-/data/jialei}"

# The code under test. By default CI tests HEAD of both repositories: verl-project/verl main and
# verl-project/verl-hardware-plugin main. To test other work, point the repository at a fork and the commit at a full
# 40-character commit id, a branch or a tag of it (set them here, as environment variables, or as workflow_dispatch
# inputs). CI copies its own files (tests/special_tpu of this branch) over the verl tree, builds the image from that
# tree's examples/tpu/grpo/Dockerfile, and ships the plugin to the Ray jobs with runtime_env py_modules. The
# build_image stage resolves branches to commit ids, and the test jobs run those exact commits.
VERL_REPO="${VERL_REPO:-https://github.com/verl-project/verl.git}"
VERL_COMMIT="${VERL_COMMIT:-main}"
VERL_HARDWARE_PLUGIN_REPO="${VERL_HARDWARE_PLUGIN_REPO:-https://github.com/verl-project/verl-hardware-plugin.git}"
VERL_HARDWARE_PLUGIN_COMMIT="${VERL_HARDWARE_PLUGIN_COMMIT:-main}"
