# Settings of the TPU CI (tests/special_tpu/run_tpu_e2e_ci.sh). Every value can be overridden by an
# environment variable of the same name.

# Ray pod image, built from examples/tpu/grpo/Dockerfile.
# Digest: sha256:b5f41f05d1ab7d7b1ada7a300ffbd24ecda0e1871a87b05ce61b46db9bca6b90
TPU_CI_IMAGE="${TPU_CI_IMAGE:-us-west2-docker.pkg.dev/tpu-pytorch/raycluster/verl-tpu:v20261013-grpo-dockerfile-v3}"

# GCS bucket mounted at /data in the Ray pods, and the directory of the bucket that holds the models
# (<dir>/assets/hf/Qwen3-*) and the data (<dir>/data/gsm8k, <dir>/data/gsm8k_sft). It is passed to the
# example scripts as RAY_DATA_HOME.
TPU_CI_BUCKET="${TPU_CI_BUCKET:-torchprime}"
TPU_CI_DATA_HOME="${TPU_CI_DATA_HOME:-/data/jialei}"

# verl-hardware-plugin (TPU support) that every test runs with: CI clones VERL_HARDWARE_PLUGIN_REPO at
# VERL_HARDWARE_PLUGIN_COMMIT and pip-installs it in the Ray jobs (runtime_env pip, --no-deps).
# - Use a full 40-character commit id (GitHub does not serve abbreviated ids).
# - The commit does not have to be in verl-project/verl-hardware-plugin: to test a verl change together
#   with a plugin change that is not merged yet, point the repository at the fork that has the commit,
#   e.g. VERL_HARDWARE_PLUGIN_REPO=https://github.com/<user>/verl-hardware-plugin.git.
# - Keep it in step with the commit examples/tpu/grpo/README.md checks out unless a test needs another one.
VERL_HARDWARE_PLUGIN_REPO="${VERL_HARDWARE_PLUGIN_REPO:-https://github.com/verl-project/verl-hardware-plugin.git}"
VERL_HARDWARE_PLUGIN_COMMIT="${VERL_HARDWARE_PLUGIN_COMMIT:-e5ab532ae41a582bd2e9183c5deaf2bd8876045f}"
